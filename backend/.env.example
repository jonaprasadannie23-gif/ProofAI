# ── LLM provider ─────────────────────────────────────────────────────────────
# "groq"   → Groq OpenAI-compatible API  (default, primary)
# "gemini" → Google Gemini SDK           (legacy, set to rollback)
LLM_PROVIDER=groq

# ── Groq configuration (primary) ─────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── Gemini configuration (legacy, kept for rollback) ─────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
